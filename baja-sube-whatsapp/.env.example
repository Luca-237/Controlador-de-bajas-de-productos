# Copiar como .env y completar. El .env NUNCA se sube al repo ni se comparte.

# Grupo a escuchar. Se puede cambiar después desde el panel (Configuración), que tiene prioridad sobre esto.
GRUPO_NOMBRE=Código que no hay más
GRUPO_JID=

# Carpeta con la sesión de WhatsApp (credenciales). NUNCA subir al repo ni compartir.
# La primera vez se vincula escaneando el QR desde el panel (Configuración).
AUTH_DIR=./auth

# Base de datos (SQLite) y logs (shadow-YYYY-MM-DD.jsonl + estado.json).
DB_PATH=./data/bajas.db
LOG_DIR=./logs

# Panel web. Escucha solo en 127.0.0.1: desde afuera se entra por nginx con HTTPS (ver DEPLOY.md).
# Si en el mismo servidor ya corre otro panel en 3010, usar otro puerto (ej. 3011).
PANEL_PORT=3010
# Hash de la clave del panel: se genera con `npm run set-password` (la clave se tipea, no se escribe acá).
PANEL_PASSWORD_HASH=

# Tienda de Cindy en Tiendanube (cindymayorista2.mitiendanube.com). Mientras esté en modo construcción pide
# una contraseña de acceso: cargarla acá (la del visitante, no la del admin). Si la tienda está abierta, dejar vacío.
TIENDANUBE_CLAVE_TIENDA=

# Opcional: validación contra Manager (solo lectura). Sin esto, el bot igual revisa las páginas.
# MANAGER_USER=
# MANAGER_PASS=

# Fase 1: guardar (truncado a 200 caracteres) el texto de los mensajes ambiguos para afinar el parser.
SHADOW_GUARDAR_TEXTO_AMBIGUO=true
